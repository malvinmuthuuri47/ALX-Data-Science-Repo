"""
This module introduces the learner to the concept of the machine learning
models called decision trees.
"""

import pandas as pd
from sklearn.model_selection import train_test_split
from sklearn.tree import DecisionTreeRegressor
from sklearn.metrics import mean_squared_error, r2_score

data = {
        'House_size': [80,95,110,130,150,170,190,210],
        'Bedrooms': [2,2,3,3,4,4,5,5],
        'Age': [20,15,12,10,8,6,4,2],
        'Price': [180,210,250,290,340,390,450,520]
        }

df = pd.DataFrame(data)

X = df.drop('Price', axis=1)
y = df['Price']

X_train, X_test, y_train, y_test = train_test_split(
        X,
        y,
        test_size=0.25,
        random_state=42
        )

tree = DecisionTreeRegressor(
        random_state=42
        )

tree.fit(X_train, y_train)

y_pred = tree.predict(X_test)

mse = mean_squared_error(y_test, y_pred)
r2 = r2_score(y_test, y_pred)

print('MSE:', mse)
print('R² Score:', r2)
