    'stress_level': [8,7,6,6,5,4,4,3,3,2]
    })

print(df)

corr_matrix = df.corr()

plot_corr(
        corr_matrix,
        xnames=corr_matrix.columns.tolist(),
        title='Correlation MAtrix - Student Performance',
        normcolor=True,
        cmap='RdBu_r'
        )

