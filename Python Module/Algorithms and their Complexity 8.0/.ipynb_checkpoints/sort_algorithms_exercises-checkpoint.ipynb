   "metadata": {},
   "source": [
    "#### Exercise 1. Write a bubble sort function that includes a flag that will allow the function to terminate when there is nothing left to sort"
   ]
  },
  {
   "cell_type": "raw",
   "id": "d62f22d2-6e73-4e58-958a-eb4349f48231",
   "metadata": {},
   "source": [
    "procedure bubble_sort(input A)\n",
    "    n = length(A)\n",
    "    repeat\n",
    "        swapped = false\n",
    "        for i = 1 to n - 1 inclusive do\n",
    "            if A[i-1] > A[i] then\n",
    "                swap(A[i-1], A[i])\n",
    "                swapped = true\n",
    "            end if\n",
    "        end for\n",
    "    until not swapped\n",
    "end procedure"
   ]
  }
 ],
